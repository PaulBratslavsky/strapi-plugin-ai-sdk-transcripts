{
  "name": "strapi-plugin-youtube-transcripts",
  "version": "2.6.1",
  "description": "Fetch, store, search and read YouTube transcripts in Strapi. Works on its own, and exposes AI tools when strapi-plugin-ai-sdk is installed.",
  "license": "MIT",
  "author": "Paul Brats <codingafterthirty@gmail.com>",
  "type": "commonjs",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "youtube",
    "transcript",
    "transcripts",
    "captions",
    "subtitles",
    "video",
    "ai",
    "mcp"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "./strapi-server.js"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "npx tsc -p admin/tsconfig.json --noEmit",
    "test:ts:back": "npx tsc -p server/tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed"
  },
  "dependencies": {
    "@strapi/design-system": "^2.0.0-rc.12",
    "@strapi/icons": "^2.0.0-rc.12",
    "react-intl": "^6.8.7",
    "undici": "^6.21.0",
    "youtubei.js": "^17.0.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@strapi/sdk-plugin": "^5.3.2",
    "@strapi/strapi": "^5.47.0",
    "@strapi/typescript-utils": "^5.47.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "styled-components": "^6.1.13",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "strapi-plugin-ai-chat": "^3.0.0",
    "styled-components": "^6.1.13"
  },
  "peerDependenciesMeta": {
    "strapi-plugin-ai-chat": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "youtube-transcripts",
    "displayName": "YouTube Transcripts",
    "description": "Fetch, store, search and read YouTube transcripts. Adds AI tools when the ai-sdk plugin is present."
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PaulBratslavsky/strapi-plugin-youtube-transcripts.git"
  },
  "homepage": "https://github.com/PaulBratslavsky/strapi-plugin-youtube-transcripts#readme",
  "bugs": {
    "url": "https://github.com/PaulBratslavsky/strapi-plugin-youtube-transcripts/issues"
  }
}
